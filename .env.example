# Copy this file to .env and fill in your own values. Never commit the real .env file.

PORT=4000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=warehouse
PGUSER=postgres
PGPASSWORD=your_password_here

# Used to sign login tokens - use a long random string in real use
JWT_SECRET=replace_with_a_long_random_string

# Set up your email service credentials here. This is used to send emails for account verification and password resets.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
FROM_EMAIL=your_email@example.com